# LLM 端点配置（OpenAI 兼容）。真实凭据只放在环境变量或密钥服务中，
# 请勿把 .env 或任何含密钥的文件提交到仓库。
# 本文件仅为字段说明，不含可用凭据。

# TRPG_LLM_BASE_URL=https://api.deepseek.com
# TRPG_LLM_API_KEY=你的密钥
# TRPG_LLM_MODEL=deepseek-flash
# TRPG_LLM_TEMPERATURE=0.8
# TRPG_LLM_MAX_TOKENS=1600

# 思考模式（DeepSeek V4 起默认开启）：on / off，不设则用供应商预设
# TRPG_LLM_THINKING=off
# 思考强度：low / high / max（仅思考打开时有意义）
# TRPG_LLM_REASONING_EFFORT=high

# 接口协议：auto（默认，优先 OpenAI Responses API）/ responses / chat
# TRPG_LLM_API_STYLE=auto

# 连接本机模型服务（Ollama/LM Studio 等）时显式放行私网/环回端点：
# TRPG_LLM_ALLOW_PRIVATE=1

# 数据看板：估算花费的参考价（元 / 百万 token，仅用于界面展示，不参与结算）
# TRPG_PRICE_IN=2
# TRPG_PRICE_OUT=3

# 数据看板：账户余额查询地址。DeepSeek / Kimi 会自动推导；
# GLM / MiniMax / 自定义供应商官方无公开余额接口，可指向兼容网关：
# TRPG_BALANCE_URL=https://gateway.example.com/v1/balance
